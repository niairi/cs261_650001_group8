    {
      "name": "1. Login (US1)",
      "description": "ตั้งค่า username / password ในแท็บ Variables ของ collection (ช่อง Current value) ก่อนรัน",
      "item": [
        {
          "name": "Login สำเร็จ (เก็บ token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/login",
            "description": "MT-01: login ด้วยบัญชี TU แล้วเก็บ token ไว้ใช้กับ request ถัดไป",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"remember\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"ได้ token และข้อมูลผู้ใช้\", () => {",
                  "  pm.expect(data.token).to.be.a(\"string\");",
                  "  pm.expect(data.user.student_id).to.be.a(\"string\");",
                  "  pm.expect(data.user.role).to.be.oneOf([\"student\", \"admin\"]);",
                  "});",
                  "if (data.token) {",
                  "  pm.collectionVariables.set(\"token\", data.token);",
                  "  pm.collectionVariables.set(\"role\", data.user.role);",
                  "  pm.collectionVariables.set(\"studentId\", data.user.student_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login ไม่กรอกข้อมูล = 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/login",
            "description": "MT-03",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"\",\n  \"password\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"error: ข้อมูลเข้าสู่ระบบไม่ถูกต้อง\", () => pm.expect(pm.response.json().error).to.eql(\"ข้อมูลเข้าสู่ระบบไม่ถูกต้อง\"));",
                  "pm.test(\"details มี: กรุณากรอกรหัสผ่าน\", () => pm.expect(pm.response.json().details).to.include(\"กรุณากรอกรหัสผ่าน\"));"
                ]

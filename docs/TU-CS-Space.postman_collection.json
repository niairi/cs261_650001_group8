      "name": "0. Health",
      "description": "เช็กว่า backend รันอยู่",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "ต้องได้ { ok: true }",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ok = true\", () => pm.expect(pm.response.json().ok).to.eql(true));"
                ]
              }
            }
          ]

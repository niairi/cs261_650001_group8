    {
      "name": "3. จองห้อง (US3, US7)",
      "description": "จองห้องสุดท้ายในรายการ วันพรุ่งนี้ 13:00-15:00 ถ้าช่วงนี้มีคนจองไว้แล้ว request แรกจะได้ 409 ให้ยกเลิกของเดิมก่อนหรือเปลี่ยนเวลา\nต้องรัน folder 1 และ 2 ก่อน",
      "item": [
        {
          "name": "จองสำเร็จ (เก็บ bookingId)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/booking",
            "description": "MT-17, MT-19: ดู terminal ของ backend ต้องมีอีเมลยืนยันการจอง",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room_id\": {{roomId}},\n  \"people\": 2,\n  \"booking_date\": \"{{tomorrow}}\",\n  \"start_time\": \"13:00\",\n  \"end_time\": \"15:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"ได้สถานะ BOOKED และข้อมูลตรงกับที่ส่ง\", () => {",
                  "  pm.expect(b.status).to.eql(\"BOOKED\");",
                  "  pm.expect(b.booking_date).to.eql(pm.collectionVariables.get(\"tomorrow\"));",
                  "  pm.expect(b.start_time).to.eql(\"13:00\");",
                  "  pm.expect(b.end_time).to.eql(\"15:00\");",
                  "  pm.expect(b.student_id).to.eql(pm.collectionVariables.get(\"studentId\"));",
                  "});",
                  "if (b.booking_id) pm.collectionVariables.set(\"bookingId\", b.booking_id);"
                ]
              }
            }
          ]
        },

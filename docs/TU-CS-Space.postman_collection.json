      "item": [
        {
          "name": "รายการห้อง (เก็บ roomId)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/rooms",
            "description": "MT-08: เก็บห้องสุดท้ายในรายการไว้ใช้ทดสอบจอง",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const rooms = pm.response.json();",
                  "pm.test(\"มีห้องอย่างน้อย 1 ห้อง และมีข้อมูลครบ\", () => {",
                  "  pm.expect(rooms.length).to.be.above(0);",
                  "  pm.expect(rooms[0]).to.have.keys(\"room_id\", \"room_name\", \"capacity\", \"location\");",
                  "  pm.expect(rooms[0].room_id).to.be.a(\"number\");",
                  "});",
                  "if (rooms.length) {",
                  "  const room = rooms[rooms.length - 1];",
                  "  pm.collectionVariables.set(\"roomId\", room.room_id);",
                  "  pm.collectionVariables.set(\"roomCapacity\", room.capacity);",
                  "}"
                ]
              }
            }
          ]
        },

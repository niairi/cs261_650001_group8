@startuml
skinparam defaultFontName Loma
skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber
title US6 : แก้ไขเวลาการจองที่ได้จองไปแล้ว (v2.0)
actor "นักศึกษา" as U
participant "Frontend\nbooking-his.html\njs/booking-his.js" as FE
participant "Backend\nPATCH /booking/:id\n(routes/bookings.js)" as R
participant "middleware\nrequireAuth" as A
participant "bookingRules" as BR
participant "blacklistService" as BL
participant "roomService" as RS
participant "emailService" as E
database "PostgreSQL\nbooking, room, room_closure,\nblacklist, email_logs" as DB

U -> FE : กด "แก้ไข" ที่การจอง
note over FE : canEdit(booking)\nสถานะ BOOKED และเหลือ อย่างน้อย 30 นาที\nไม่งั้นปุ่มแก้ไขกดไม่ได้ (TC4)
FE -> FE : showEditDialog(booking)\nloadRoomOptions(): GET /rooms
U -> FE : เลือกห้อง/วัน/เวลาใหม่ แล้วกดบันทึก
FE -> R : PATCH /booking/:id\n{ room_id, booking_date, start_time, end_time }
R -> A : ตรวจ token
alt ไม่มี token / หมดอายุ
  A --> FE : 401 กรุณาเข้าสู่ระบบ
else token ถูกต้อง
  A -> R : req.user
  R -> DB : BEGIN\nSELECT booking JOIN room ... FOR UPDATE OF b
  alt ไม่พบการจอง
    R --> FE : 404 ไม่พบการจองนี้
  else ไม่ใช่การจองของตัวเอง
    R --> FE : 403 แก้ไขได้เฉพาะการจองของตัวเองเท่านั้น
  else สถานะ CANCELLED / EXPIRED
    R --> FE : 409 การจองนี้ถูกยกเลิก / หมดอายุแล้ว
  else
    R -> BR : assertChangeable(old, 'แก้ไข')
    alt เหลือไม่ถึง 30 นาทีก่อนเริ่ม (TC4)
      BR --> FE : 400 แก้ไขได้ก่อนเวลาเริ่มอย่างน้อย 30 นาที
    else
      R -> BL : assertNotBlacklisted(student_id)
      BL -> DB : SELECT blacklist (ยังไม่หมดอายุ, ยังไม่ปลด)
      alt ถูกระงับสิทธิ์ (US10)
        BL --> FE : 403 คุณถูกระงับสิทธิ์การจองถึงวันที่ ...
      else
        R -> BR : validateBooking(ค่าใหม่ + ค่าเดิม)\nจันทร์–ศุกร์, 09:00–16:00,\nไม่เกิน 3 ชม., ไม่เกิน 7 วัน
        alt ไม่ผ่านเงื่อนไข เช่น เกิน 3 ชม. (TC3) / เสาร์–อาทิตย์
          BR --> FE : 400 ข้อมูลการจองไม่ถูกต้อง + details
        else ไม่มีอะไรเปลี่ยน
          R --> FE : 400 ไม่มีข้อมูลการจองที่เปลี่ยนแปลง
        else ผ่าน
          R -> DB : SELECT room ... FOR UPDATE\n(ห้องเปิดใช้งาน, ความจุ)
          R -> RS : assertRoomOpen(room_id, date)
          RS -> DB : SELECT room_closure
          alt ห้องปิดปรับปรุงวันนั้น (US12)
            RS --> FE : 409 ห้องนี้ปิดปรับปรุงในวันที่เลือก
          else
            R -> DB : ตรวจเวลาทับซ้อน\n(BOOKED/CONFIRMED, ไม่นับการจองนี้)
            alt ช่วงใหม่ถูกจองแล้ว (TC2)
              R -> DB : ROLLBACK (การจองเดิมยังอยู่)
              R --> FE : 409 ช่วงเวลานี้ถูกจองแล้ว
            else ว่าง (TC1)
              R -> DB : UPDATE booking SET ค่าใหม่\nCOMMIT
              R ->> E : sendBookingUpdate(to, ใหม่, เดิม) (ไม่รอ)
              E ->> DB : INSERT email_logs (BOOKING_UPDATED)
              R --> FE : 200 แก้ไขการจองสำเร็จ\n{ booking, previous }
              FE --> U : แสดงเวลาใหม่\nช่วงเวลาเดิมกลับมาว่าง
            end
          end
        end
      end
    end
  end
end
@enduml

@startuml
skinparam defaultFontName Loma
skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber
title US9–US10 : นับ No-show อัตโนมัติ และแบน (Blacklist) 30 วันเมื่อครบ 3 ครั้ง
participant "server.js\nstartNoShowScheduler\n(ทุก 1 นาที)" as T
participant "noShowService" as N
participant "blacklistService" as BL
participant "emailService" as E
database "PostgreSQL\nbooking, blacklist,\nemail_logs" as DB
actor "นักศึกษา" as U
participant "Frontend" as FE
participant "Backend\nPOST /booking\nGET /users/me/status" as R
participant "noShowStatus" as S

== US9 : ตรวจ No-show ==
T -> N : runNoShowCheck(db, { now, onNoShow })
N -> DB : expireNoShows()\nUPDATE booking SET status = 'EXPIRED'\nWHERE status = 'BOOKED'\nAND เลยเวลาเริ่มมาแล้ว 15 นาที (NO_SHOW_GRACE_MIN)
DB --> N : รายการที่เปลี่ยนเป็น EXPIRED
loop แต่ละการจองที่ไม่ Check-in (TC1)
  N -> DB : countNoShows(student_id, ภาคการศึกษานี้)
  N -> BL : onNoShow → handleNoShow({ booking, no_show_count })
  BL -> DB : countNoShowsSinceLastBan()
  alt ครบ 3 ครั้ง (US10 TC1)
    BL -> DB : INSERT blacklist (30 วัน)
    BL ->> E : sendNotice() แจ้งระงับสิทธิ์
    E ->> DB : INSERT email_logs
  else ยังไม่ครบ 3 (US10 TC4)
    BL --> N : ยังไม่แบน
  end
end
note over N
  CONFIRMED (TC2) และ CANCELLED (TC3)
  ไม่ถูกเลือก จึงไม่นับเป็น No-show
end note

== US9 TC4 : ดูจำนวน No-show ของตัวเอง ==
U -> FE : เปิดหน้าการจองของฉัน
FE -> R : GET /users/me/status
R -> S : getUserStatus(db, student_id)
S -> DB : นับ No-show + หา blacklist ที่ยังไม่หมดอายุ
R --> FE : 200 { จำนวน No-show, สถานะระงับสิทธิ์ }
FE --> U : No-show ภาคการศึกษานี้: 1 / 3 ครั้ง

== US10 TC2–TC3 : จอง / แก้ไขระหว่างถูกระงับสิทธิ์ ==
U -> FE : กดจองห้อง
FE -> R : POST /booking
R -> BL : assertNotBlacklisted(student_id)
alt ถูกระงับอยู่ (TC2)
  BL --> FE : 403 คุณถูกระงับสิทธิ์การจองถึงวันที่ ...
else พ้นกำหนดแล้ว (TC3) / ไม่เคยถูกแบน
  R -> DB : INSERT booking (ขั้นตอนเดียวกับ US3)
  R --> FE : 201 จองสำเร็จ
end
@enduml

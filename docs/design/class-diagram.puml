@startuml
skinparam defaultFontName Loma
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor<<Sprint 2>> #E8F8F5
  BorderColor<<Sprint 2>> #117A65
}
title Class Diagram : Backend (Node.js + Express) — Sprint 1 + Sprint 2

package "routes (Express Router)" {
  class LoginRouter <<router>> {
    + POST /login
  }
  class RoomsRouter <<router>> {
    + GET /rooms?date=  (closed ของ US12)
  }
  class BookingsRouter <<router>> {
    + POST /booking
    + GET /booking?date=
    + GET /booking/me
    + PATCH /booking/:id/cancel
    + POST /booking/:id/resend-email  (US5 TC3)
    + PATCH /booking/:id  (US6)
    + POST /booking/:id/checkin  (US8)
  }
  class UsersRouter <<router>> {
    + GET /users/me/status  (US9, US10)
  }
  class AdminRouter <<router>> {
    + GET /admin/bookings
    + GET /admin/reports/summary  (US7)
    + GET /admin/rooms  (US12)
    + POST /admin/rooms  (US12)
    + PATCH /admin/rooms/:id  (US12)
    + POST /admin/rooms/:id/closures  (US12)
    + DELETE /admin/rooms/:id/closures/:date  (US12)
    + GET /admin/blacklist  (US13)
    + POST /admin/blacklist/:id/lift  (US13)
  }
}

package "middleware" {
  class Auth <<module>> {
    + requireAuth(req, res, next)
    + requireAdmin(req, res, next)
  }
}

package "services" {
  class LoginService <<module>> {
    + login(body) : LoginResponse
    + roleOf(studentId) : string
    + isAllowedDepartment(department) : boolean  (US14)
  }
  class TuAuth <<module>> {
    + verifyWithTU(username, password) : TuUser
    + isMockMode() : boolean
    + parseMockUsers(raw) : Map  (US15)
    - mockVerify(username, password)
  }
  class BookingRules <<Sprint 2>> {
    + OPEN = '09:00'
    + CLOSE = '16:00'
    + MAX_HOURS = 3
    + CHANGE_BEFORE_MIN = 30
    + validateBooking(body, now)  (จันทร์–ศุกร์ BUG-01)
    + assertChangeable(booking, action, now)
    + minutesUntilStart(date, time, now)
    + distanceMeters(lat1, lon1, lat2, lon2)  (US8)
    + assertCheckinTime(booking, now)  (US8)
    + assertWithinRadius(distance)  (US8)
  }
  class EmailService <<module>> {
    + sendBookingConfirmation(to, booking)
    + sendBookingCancellation(to, booking)
    + sendBookingUpdate(to, booking, previous)  (US6)
    + sendBlacklistNotice(to, info)  (US10)
    + emailDeliveryStatus(sending, timeoutMs)  (US5 TC3)
    + formatThaiDate(date) : string
  }
  class AdminService <<module>> {
    + listBookings(db, filters)
    + buildBookingQuery(filters)
    + bookingSummary(db, filters, now)  (US7)
    + buildSummaryQuery(filters, now)
  }
  class NoShowService <<Sprint 2>> {
    + startNoShowScheduler(db, options)
    + runNoShowCheck(db, { now, onNoShow })
    + expireNoShows(db, now)
    + countNoShows(db, studentId, semester) : number
  }
  class NoShowStatus <<Sprint 2>> {
    + getUserStatus(db, studentId)
  }
  class BlacklistService <<Sprint 2>> {
    + createBlacklistService({ db, sendNotice })
    + handleNoShow(event)
    + getActiveBlacklist(studentId)
    + countNoShowsSinceLastBan(studentId)
    + assertNotBlacklisted(studentId)
    + listActiveBlacklist()  (US13)
    + liftBlacklist(blacklistId, adminId)  (US13)
  }
  class RoomService <<Sprint 2>> {
    + listRoomsForDate(db, date)  (US12 TC1)
    + listRoomsForAdmin(db)
    + createRoom(db, body)
    + updateRoom(db, roomId, body)
    + addClosure(db, roomId, body, adminId)
    + removeClosure(db, roomId, date)
    + assertRoomOpen(db, roomId, date)
  }
}

package "repositories" {
  class UserRepo <<module>> {
    + upsertUser(db, user)
  }
  class EmailLogRepo <<module>> {
    + insertEmailLog(db, log)
  }
}

package "infrastructure" {
  class Db <<pg.Pool>> {
    + query(sql, params)
    + connect()
  }
  class HttpError {
    + status : number
    + message : string
    + details : string[]
  }
  class TuApiError
}

LoginRouter --> LoginService
LoginService --> TuAuth
LoginService --> UserRepo
BookingsRouter --> Auth
BookingsRouter --> BookingRules
BookingsRouter --> BlacklistService
BookingsRouter --> EmailService
BookingsRouter --> Db
RoomsRouter --> RoomService
BookingsRouter --> RoomService
AdminRouter --> RoomService
AdminRouter --> BlacklistService
RoomService --> Db
AdminRouter --> Auth
AdminRouter --> AdminService
AdminService --> Db
UsersRouter --> Auth
UsersRouter --> NoShowStatus
NoShowStatus --> Db
NoShowService --> BlacklistService
NoShowService --> Db
BlacklistService --> EmailService
BlacklistService --> Db
EmailService --> EmailLogRepo
UserRepo --> Db
EmailLogRepo --> Db
HttpError -[hidden]- TuApiError

legend right
  สีเขียว = เพิ่มใน Sprint 2
  ตามโค้ด Release v2.0 (tag v2.0, commit 82751ab · 15 พ.ย. 2569)
endlegend
@enduml

@startuml
skinparam defaultFontName Loma
skinparam defaultFontSize 13
hide circle
skinparam linetype ortho
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1F4E79
  HeaderBackgroundColor #D6EAF8
}
title ER Diagram : ฐานข้อมูล PostgreSQL (ตาม schema.sql และ 002_users_and_email_logs.sql)

entity "users" as users {
  * student_id : VARCHAR(50) <<PK>>
  --
  name_th : VARCHAR(255)
  name_en : VARCHAR(255)
  email : VARCHAR(255)
  type : VARCHAR(20) -- student / employee
  department : VARCHAR(255)
  faculty : VARCHAR(255)
  * role : VARCHAR(20) -- student / admin
  * created_at : TIMESTAMP
  * last_login_at : TIMESTAMP
}

entity "room" as room {
  * room_id : BIGSERIAL <<PK>>
  --
  * room_name : VARCHAR(100)
  * capacity : INTEGER -- > 0
  location : VARCHAR(255)
  * is_active : BOOLEAN -- default TRUE
}

entity "booking" as booking {
  * booking_id : BIGSERIAL <<PK>>
  --
  * student_id : VARCHAR(50) <<FK>>
  * room_id : BIGINT <<FK>>
  * booking_date : DATE
  * start_time : TIME
  * end_time : TIME
  * people : INTEGER -- > 0
  purpose : VARCHAR(255)
  * status : VARCHAR(20) -- BOOKED / CONFIRMED / CANCELLED / EXPIRED
  * created_at : TIMESTAMP
  confirmed_at : TIMESTAMP
}

entity "email_logs" as email_logs {
  * email_log_id : BIGSERIAL <<PK>>
  --
  booking_id : BIGINT <<FK>>
  to_email : VARCHAR(255)
  * email_type : VARCHAR(30) -- BOOKING_CONFIRMED / BOOKING_CANCELLED
  * status : VARCHAR(20) -- SENT / FAILED / SKIPPED
  error_message : TEXT
  * created_at : TIMESTAMP
}

users ||--o{ booking : "ทำการจอง"
room ||--o{ booking : "ถูกจอง"
booking |o--o{ email_logs : "มีประวัติการส่งอีเมล"

note bottom of booking
  CHECK end_time > start_time
  CHECK end_time - start_time <= 3 ชั่วโมง
  CHECK status IN (BOOKED, CONFIRMED, CANCELLED, EXPIRED)
  Index: idx_booking_student (student_id)
end note
@enduml

@startuml
skinparam defaultFontName Tahoma
skinparam defaultFontSize 13
hide circle
skinparam linetype ortho

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1F4E79
  HeaderBackgroundColor #D6EAF8
}

title ER Diagram : Sprint 2 – US8, US9, US10

entity "USERS" as users {
  * student_id : VARCHAR(50) <<PK>>
  --
  name_th : VARCHAR(255)
  name_en : VARCHAR(255)
  email : VARCHAR(255)
  type : VARCHAR(20)
  department : VARCHAR(255)
  faculty : VARCHAR(255)
  role : VARCHAR(20)
  created_at : TIMESTAMP
  last_login_at : TIMESTAMP
}

entity "ROOM" as room {
  * room_id : BIGSERIAL <<PK>>
  --
  room_name : VARCHAR(100)
  capacity : INTEGER
  location : VARCHAR(255)
  is_active : BOOLEAN
  latitude : DECIMAL(10,7)
  longitude : DECIMAL(10,7)
}

entity "BOOKING" as booking {
  * booking_id : BIGSERIAL <<PK>>
  --
  student_id : VARCHAR(50) <<FK>>
  room_id : BIGINT <<FK>>
  booking_date : DATE
  start_time : TIME
  end_time : TIME
  people : INTEGER
  purpose : VARCHAR(255)
  status : VARCHAR(20)
  created_at : TIMESTAMP
  confirmed_at : TIMESTAMP
}

entity "EMAIL_LOGS" as email_logs {
  * email_log_id : BIGSERIAL <<PK>>
  --
  booking_id : BIGINT <<FK>>
  to_email : VARCHAR(255)
  email_type : VARCHAR(30)
  status : VARCHAR(20)
  error_message : TEXT
  created_at : TIMESTAMP
}

entity "BLACKLIST" as blacklist {
  * blacklist_id : BIGSERIAL <<PK>>
  --
  student_id : VARCHAR(50) <<FK>>
  trigger_booking_id : BIGINT <<FK>>
  start_date : DATE
  end_date : DATE
  reason : VARCHAR(255)
  created_at : TIMESTAMP
}

users ||--o{ booking : "ทำการจอง"
room ||--o{ booking : "ถูกจอง"
booking ||--o{ email_logs : "มีประวัติการส่งอีเมล"

users ||--o{ blacklist : "ได้รับ Blacklist"
booking ||--o| blacklist : "เป็นต้นเหตุ"

note bottom of booking
  CHECK end_time > start_time
  CHECK end_time - start_time <= 3 ชั่วโมง
  CHECK status IN (BOOKED, CONFIRMED, CANCELLED, EXPIRED)
  Index: idx_booking_student (student_id)
end note

note bottom of blacklist
  UNIQUE trigger_booking_id
  Blacklist เมื่อ No-show ครบ 3 ครั้ง
  ระยะเวลา Blacklist 30 วัน
end note

@enduml
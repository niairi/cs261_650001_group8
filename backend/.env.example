PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/room_booking
JWT_SECRET=change-me
# URL ของ frontend ที่อนุญาตให้เรียก API (CORS) คั่นหลายค่าด้วย , — ค่านี้สำหรับ Live Server ใน VS Code
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# กฎการจอง (เวลาไทย) ตาม docs/database-guide.md
TZ=Asia/Bangkok
FIRST_START_HOUR=9        # เวลาเริ่มที่เลือกได้ 09:00 ...
LAST_START_HOUR=15        # ... ถึง 15:00
CLOSE_HOUR=16           # เวลาสิ้นสุดต้องไม่เกิน 16:00
MAX_HOURS_PER_BOOKING=3   # ไม่เกิน 3 ชั่วโมง
BOOKING_DAYS_AHEAD=7      # 1 = จองได้วันนี้กับพรุ่งนี้

# อีเมลยืนยันการจอง (US7) — ถ้าไม่ใส่ SMTP_HOST ระบบจะแสดงอีเมลใน Terminal แทนการส่งจริง
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TU CS Space <no-reply@example.com>"

# ---------- No-show อัตโนมัติ (US9 · Task67) ----------
NO_SHOW_GRACE_MIN=15            # ไม่ Check-in ภายในกี่นาทีหลังเวลาเริ่ม = No-show
NO_SHOW_CHECK_INTERVAL_MS=60000 # ตรวจทุกกี่ ms (0 = ปิด)
NO_SHOW_LIMIT=3                 # ครบกี่ครั้งในภาคการศึกษาจึงระงับสิทธิ์ (US10)
SEMESTER_START=                 # วันเริ่มภาคการศึกษา YYYY-MM-DD (ว่าง = นับทั้งหมด)
SEMESTER_END=                   # วันสิ้นสุดภาคการศึกษา YYYY-MM-DD

# ---------- Login (US1) ----------
# Application-Key ของ TU API — ถ้าว่างไว้ = โหมดจำลอง (รับรหัสผ่านอะไรก็ได้ ไว้ทดสอบ)
TU_API_KEY=
TU_API_URL=https://restapi.tu.ac.th/api/v1/auth/Ad/verify
# อายุ token ปกติ (ติ๊ก "จดจำการเข้าสู่ระบบ" = 7 วัน)
JWT_EXPIRES_IN=8h
# รหัสของเจ้าหน้าที่ที่เป็น admin (US5) คั่นด้วย ,
ADMIN_IDS=
# อีเมลที่ใช้ในโหมดจำลอง (ว่าง = รหัสนักศึกษา@dome.tu.ac.th)
MOCK_EMAIL=

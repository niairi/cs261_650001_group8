# ตัวอย่างค่าสำหรับ docker compose (Task10)
# วิธีใช้: copy ไฟล์นี้เป็น .env ที่ root แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)
# ถ้าไม่ใส่ TU_API_KEY ระบบจะรันโหมดจำลอง: login ได้เฉพาะบัญชีใน MOCK_USERS และอีเมลแสดงใน log ของ backend

JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
BOOKING_DAYS_AHEAD=7

# Login ผ่าน TU API (ว่าง = โหมดจำลอง)
TU_API_KEY=

# บัญชีทดสอบของโหมดจำลอง รูปแบบ รหัส:รหัสผ่าน[:สาขา] คั่นด้วย , (ไม่ตั้ง = login ไม่ได้ทุกบัญชี)
MOCK_USERS=6809650069:test1234

# รหัสเจ้าหน้าที่ที่เป็น admin คั่นด้วย ,
ADMIN_IDS=

# ส่งอีเมลจริง (ว่าง = แสดงอีเมลใน log แทน)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ตรวจสาขา (US14) ชื่อสาขาที่ยอมรับ คั่นด้วย , — ว่าง = ยังไม่ตรวจ · ตั้งหลังยืนยันชื่อจริงจาก TU API
ALLOWED_DEPARTMENTS=

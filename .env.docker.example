# ตัวอย่างค่าสำหรับ docker compose (Task10)
# วิธีใช้: copy ไฟล์นี้เป็น .env ที่ root แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)
# ถ้าไม่สร้าง .env เลย ระบบจะรันโหมดจำลอง: login รหัสอะไรก็ได้ และอีเมลแสดงใน log ของ backend

JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
BOOKING_DAYS_AHEAD=7

# Login ผ่าน TU API (ว่าง = โหมดจำลอง)
TU_API_KEY=

# รหัสเจ้าหน้าที่ที่เป็น admin คั่นด้วย ,
ADMIN_IDS=

# ส่งอีเมลจริง (ว่าง = แสดงอีเมลใน log แทน)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=